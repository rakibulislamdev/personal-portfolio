generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  category    String
  image       String
  altText     String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisitorLog {
  id        String   @id @default(cuid())
  ip        String
  country   String   @default("Unknown")
  city      String   @default("Unknown")
  flag      String   @default("🌐")
  page      String
  device    String   @default("Unknown")
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("Unread")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  views       Int      @default(0)
  status      String   @default("Published")
  content     String?  @db.Text
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProfileSettings {
  id               String   @id @default("default")
  name             String   @default("Rakibul Islam")
  title            String   @default("Web Developer & Frontend Specialist")
  email            String   @default("rirakib03@gmail.com")
  phone            String   @default("+8801621-574994")
  location         String   @default("Pabna, Bangladesh")
  github           String   @default("https://github.com/Rakibul-Islam-1")
  linkedin         String   @default("https://linkedin.com/in/rakibul-islam")
  facebook         String   @default("https://facebook.com")
  twitter          String   @default("https://twitter.com")
  instagram        String   @default("https://instagram.com")
  profileImage     String   @default("/assets/Images/rakibulislam.jpg")
  aboutImage       String   @default("/assets/Images/rakibulislam.jpg")
  typewriterText   String   @default("Web Developer based in Bangladesh")
  aboutBio         String   @default("I am a Pabna, Bangladesh-based web developer with a focus on web development. I have a diverse range of experience having worked on various web applications.")
  experienceMonths Int      @default(6)
  githubInContact         Boolean  @default(true)
  linkedinInContact       Boolean  @default(true)
  facebookInContact       Boolean  @default(true)
  twitterInContact        Boolean  @default(true)
  instagramInContact      Boolean  @default(true)
  githubInProfilesCard    Boolean  @default(true)
  linkedinInProfilesCard  Boolean  @default(true)
  facebookInProfilesCard  Boolean  @default(false)
  twitterInProfilesCard   Boolean  @default(false)
  instagramInProfilesCard Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}
